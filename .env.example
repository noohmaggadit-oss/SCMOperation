# Copy this file to ".env" and change the values. Restart the app after changes.

# Port and network interface. 0.0.0.0 lets phones / tablets on the same network connect.
PORT=3000
HOST=0.0.0.0

# First administrator (used only when the database has no users yet).
ADMIN_USERNAME=admin
# Leave empty to get a random password printed in the terminal on first start.
ADMIN_PASSWORD=

# Where the database and uploaded files are kept.
DATA_DIR=data

APP_NAME=SCM IN / OUT Operations
SESSION_HOURS=12
REMEMBER_DAYS=30
MAX_UPLOAD_MB=25
KEEP_UPLOAD_FILES=true

# Behind a reverse proxy (IIS, Nginx, Caddy, Cloudflare Tunnel) set TRUST_PROXY=true.
TRUST_PROXY=false
# auto = Secure cookies when the page is opened over HTTPS.
COOKIE_SECURE=auto

# Optional: serve HTTPS directly (paths to PEM files).
HTTPS_KEY=
HTTPS_CERT=
